# Copy to .env.production.local (or set in CI) for a build that talks to another backend.
# Base URL of Dental-Api, without /api/v1 and without a trailing slash.
VITE_API_BASE_URL=http://localhost:3000
# Temporary: the clinic to act for, sent as the x-clinic-id header until login exists.
VITE_CLINIC_ID=00000000-0000-7000-8000-000000000001
